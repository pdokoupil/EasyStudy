# Copy to .env and adjust. All values are optional (sane defaults apply).
# SECURITY: set a real SECRET_KEY for any non-local deployment.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql+psycopg://easystudy:easystudy@db/easystudy
DATABASE_URL=sqlite:///db.sqlite
SESSION_TYPE=sqlalchemy
# For redis sessions: SESSION_TYPE=redis and REDIS_URL=redis://redis:6379
REDIS_URL=
# Host-side port for `docker compose up` (http://localhost:$PORT). The container itself always
# listens on 8000 internally; PORT only changes which host port maps to it.
PORT=8000
# Extra algorithm backends baked into the image at build time (comma-separated pyproject
# extras). The default (empty) ships only the lightweight core algorithms: EASE, Popularity,
# Random. Add extras to unlock more — then rebuild: `docker compose up --build`.
#   recbole     -> RecBole model zoo: BPR, LightGCN, NeuMF, NGCF, DMF (pulls PyTorch, ~large)
#   tensorflow  -> VAE, RBM, TF-Recommenders MF (pulls TensorFlow, ~large)
#   lenskit     -> ItemKNN, UserKNN, ImplicitMF, LensKit baselines (legacy LensKit API)
# e.g. EASYSTUDY_EXTRAS=recbole   or   EASYSTUDY_EXTRAS=recbole,tensorflow,lenskit
EASYSTUDY_EXTRAS=
# Python version for the image. The `recbole` extra needs `ray`, which only has wheels up to
# 3.11, so build recbole (and other old-wheel extras) on 3.11:
#   PYTHON_VERSION=3.11 EASYSTUDY_EXTRAS=recbole docker compose up --build
PYTHON_VERSION=3.12
# Keep 1 unless you have done the shared-state rework (see 03_V2_TECHNICAL.md):
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=0
